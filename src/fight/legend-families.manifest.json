{
  "tables": [
    {
      "table": "legend",
      "file": "legend-rows.json",
      "at": "legends",
      "key": "id",
      "required": { "name": "string", "source": "string", "backstory": "string" },
      "optional": { "spellless": "boolean" },
      "unique": ["name"]
    },
    {
      "table": "legend-family",
      "file": "legend-families.json",
      "at": "families",
      "key": "id",
      "required": { "opponent": "string", "region": "string", "legends": "array", "legends[].legendId": "string", "legends[].rank": "integer" },
      "refs": { "legends[].legendId": "legend" }
    }
  ]
}
