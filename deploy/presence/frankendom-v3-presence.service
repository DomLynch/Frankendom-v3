# /etc/systemd/system/frankendom-v3-presence.service   (NOT installed by this repo: deploy/presence/README.md is the ordered runbook, run on an explicit go)
# V3's presence service (server/presence/main.ts): who is where in the live zone, in memory, on 127.0.0.1:8794 behind nginx (frankendom-v3-presence.conf). It writes nothing to disk and decides nothing that pays.
# The name carries -v3- on purpose: the VPS already has V1's /etc/systemd/system/frankendom-presence.service (port 8793, /opt/frankendom-presence); this unit must never overwrite or share it.
# Pinned checkout: /opt/frankendom-v3-presence/current is a symlink to releases/<commit sha> (git archive of the repo at that sha: server/, src/presence/, data/presence.json, package.json). No npm dependency.
# The port, the 20/24 layer caps and every limit are rows in data/presence.json inside that checkout; the one env override is PRESENCE_HOST, left unset (loopback).
[Unit]
Description=Frankendom V3 presence (live zone, other players)
After=network.target
# Stop a crash loop from burning the shared box: 5 starts in 60 s and systemd gives up (a person looks). These two keys belong in [Unit]
# (in [Service] systemd 255 ignores them with 'Unknown key name', verified by systemd-analyze on the box 2026-10-27).
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=frankendom-v3-presence
Group=frankendom-v3-presence
WorkingDirectory=/opt/frankendom-v3-presence/current
ExecStart=/usr/bin/node server/presence/main.ts
Restart=on-failure
RestartSec=3
TimeoutStopSec=10

# The VPS is shared and already loaded: a runaway here is stopped by the kernel, not by hope. A guard, not a measured figure: V1's same service sits at about 75 MB resident idle on this box (2026-10-27), so 256M is 3x that; CPUQuota=50% is half a core of the 16.
MemoryHigh=192M
MemoryMax=256M
TasksMax=64
CPUQuota=50%
CPUWeight=100
Nice=5
LimitNOFILE=1024

# Network-facing and with nothing to protect inside it: unprivileged user, read-only filesystem (it writes nothing), private /tmp, no capabilities.
# It only listens on loopback and never dials out, so it may only use IP sockets and may not reach anything but nginx. MemoryDenyWriteExecute stays off (V8).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077
# stdout and stderr go to the journal (journalctl -u frankendom-v3-presence); no log file to rotate.

[Install]
WantedBy=multi-user.target
