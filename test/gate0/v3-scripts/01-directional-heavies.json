{
  "id": "directional-heavies",
  "about": "V3 only (no V1 reference: V1 has no such action). Draw, close in, then the three directional heavies tapped, held to the chamber and held to the charge, a plain heavy between them, lights chained into them and a guard press after some.",
  "segments": [
    { "ticks": 1, "action": "light" },
    { "ticks": 45 },
    { "ticks": 60, "move": { "z": -1 } },
    { "repeat": 18, "segments": [
      { "ticks": 1, "action": "heavy_right", "move": { "z": -0.5 } },
      { "ticks": 50 },
      { "ticks": 30, "action": "heavy_left", "held": true },
      { "ticks": 40 },
      { "ticks": 75, "action": "heavy_thrust", "held": true, "move": { "z": -0.3 } },
      { "ticks": 12, "action": "light", "every": 6 },
      { "ticks": 50, "action": "heavy_left" },
      { "ticks": 50, "action": "heavy" },
      { "ticks": 12, "action": "light_left" },
      { "ticks": 50, "action": "heavy_right", "held": true },
      { "ticks": 20, "guard": true, "guardDirection": "left" },
      { "ticks": 40, "action": "heavy_thrust" },
      { "ticks": 30, "move": { "z": -1 } }
    ] }
  ]
}
