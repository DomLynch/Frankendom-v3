{
  "id": "random-mix",
  "about": "A minute of seeded random play (mulberry32 from `seed`, harness.mjs randomSegments): segments of 4-40 ticks, each with a random move, action, guard, held, lock and cancel drawn with these odds. Every number is here, none in code.",
  "random": {
    "seed": 20261026,
    "ticks": 3600,
    "prelude": [ { "ticks": 1, "action": "light" }, { "ticks": 45 } ],
