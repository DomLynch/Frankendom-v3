    "moveChance": 0.7,
    "runChance": 0.15,
    "actionChance": 0.55,
    "actions": { "light": 6, "light_left": 2, "light_right": 2, "heavy": 3, "thrust": 2, "kick": 2, "dodge": 2, "backstep": 1, "parry": 2, "skill": 1, "skill2": 1 },
    "repeatChance": 0.3,
    "every": [5, 20],
    "guardChance": 0.2,
    "directionChance": 0.5,
    "directions": ["left", "right", "overhead", "thrust", "low"],
    "heldChance": 0.25,
    "unlockChance": 0.1,
    "cancelChance": 0.05
  }
}
