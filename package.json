{
  "name": "frankendom-v3",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "serve": "node scripts/serve.mjs",
    "presence": "node server/presence/main.ts",
    "telemetry": "node server/telemetry/main.ts",
    "presence:smoke": "node server/presence/smoke.ts",
    "check:stubs": "node scripts/check-stubs.mjs",
    "check:as-data": "node scripts/as-data/check.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "node --test \"test/**/*.test.mjs\"",
    "perf:rows": "node --test \"test/perf/**/*.perf.mjs\"",
    "test:pins": "node --test \"test/source-pins/*.test.mjs\"",
    "check:source-regex": "node scripts/source-regex-tests.mjs --check",
    "gate0": "node --test test/gate0/gate0.test.mjs",
    "gate0:table": "node scripts/gate0-table.mjs",
    "gate0:v3": "node scripts/gate0-v3-golden.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/three": "0.186.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "meshoptimizer": "1.2.0",
    "pg": "8.16.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "dependencies": {
    "@frankendom/physics": "https://codeload.github.com/DomLynch/physics/tar.gz/31e1ac93b2841f24130c3192086e43a89a7ab0ef",
    "three": "0.186.0"
  }
}
